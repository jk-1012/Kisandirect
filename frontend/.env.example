# Frontend Environment Configuration (KisanDirect Phase 1)
# Copy this file to .env.local and replace placeholder values

# ============================================================
# API ENDPOINTS
# ============================================================
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# PAYMENT PROCESSING (Razorpay - Public Key Only)
# ============================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_public_key

# ============================================================
# THIRD-PARTY INTEGRATIONS (Public)
# ============================================================
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_if_using
NEXT_PUBLIC_MAPMYINDIA_API_KEY=your_mapmyindia_api_key

# ============================================================
# ANALYTICS (Optional)
# ============================================================
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_if_using
NEXT_PUBLIC_GTAG_ID=your_google_analytics_id_if_using

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
NEXT_PUBLIC_APP_NAME=KisanDirect
NEXT_PUBLIC_DEFAULT_LANGUAGE=en
NEXT_PUBLIC_SUPPORTED_LANGUAGES=en,hi,kn,te,ta,mr,gu,bn,or,pa,ml,as

# Deployment environment
NODE_ENV=development
