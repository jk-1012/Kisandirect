{
  "name": "kisandirect",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "build": "npm --prefix frontend run build && npm --prefix backend run build",
    "lint": "npm --prefix frontend run lint && npm --prefix backend run lint",
    "db:migrate": "npm --prefix backend run db:migrate",
    "test:unit": "npm --prefix backend exec jest --config ./jest.config.js"
  },
  "devDependencies": {
    "concurrently": "^8.0.0"
  }
}
