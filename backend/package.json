    "@fastify/swagger": "^9.0.0",
    "@opensearch-project/opensearch": "^2.0.0",
    "bcrypt": "^5.1.0",
    "bullmq": "^2.0.0",
    "dotenv": "^16.0.0",
    "fastify": "^4.0.0",
