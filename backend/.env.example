# ============================================================
# DATABASE & PERSISTENCE
# ============================================================
DATABASE_URL=postgresql://username:password@localhost:5432/kisandirect
TEST_DATABASE_URL=postgresql://username:password@localhost:5432/kisandirect_test
REDIS_URL=redis://localhost:6379

# ============================================================
# AUTHENTICATION & SECURITY
# ============================================================
JWT_SECRET=replace-with-strong-secret-min-32-chars
MSG91_AUTH_KEY=replace-with-msg91-auth-key
MSG91_OTP_TEMPLATE_ID=replace-with-otp-template-id

# ============================================================
# DigiLocker KYC OAuth2 Configuration
# ============================================================
# OAuth2 Credentials (from DigiLocker API developer console)
DIGILOCKER_CLIENT_ID=replace-with-client-id
DIGILOCKER_CLIENT_SECRET=replace-with-client-secret
DIGILOCKER_REDIRECT_URI=http://localhost:4000/api/v1/farmers/kyc/callback

# DigiLocker API Endpoints
DIGILOCKER_AUTH_URL=https://api.digilocker.gov.in/oauth/authorize
DIGILOCKER_TOKEN_URL=https://api.digilocker.gov.in/oauth/token
DIGILOCKER_API_BASE=https://api.digilocker.gov.in

# KYC Session Configuration (in seconds)
KYC_SESSION_TTL_SECONDS=600
KYC_EXPIRY_DAYS=365

# ============================================================
# Encryption Configuration for Vault Storage
# ============================================================
# Master encryption key for sensitive KYC data (AES-256)
# Generate with: openssl rand -hex 32 (produces 64-character hex string)
# CRITICAL: Must be exactly 64 characters (32 bytes) for AES-256
ENCRYPTION_KEY=replace_with_64_char_hex_string_e.g.a1b2c3d4e5f6...

# Key rotation ID (change this to rotate keys without decryption)
ENCRYPTION_KEY_ID=primary_key_v1

# Legacy encryption keys (if rotating, keep old keys for decryption)
# ENCRYPTION_KEY_V2=backup_key_hex_string
# ENCRYPTION_KEY_ID_V2=backup_key_v2

# Deprecated: These can still be used but prefer the unified ENCRYPTION_KEY above
AADHAAR_ENCRYPTION_KEY=replace_with_64_char_hex_string
PAN_ENCRYPTION_KEY=replace_with_64_char_hex_string

# ============================================================
# PAYMENT PROCESSING (Razorpay)
# ============================================================
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-webhook-secret-from-dashboard
COMMISSION_STANDARD_PERCENT=2
COMMISSION_PREMIUM_PERCENT=3
TDS_THRESHOLD_INR=100000

# ============================================================
# AWS & STORAGE CONFIGURATION
# ============================================================
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
LISTINGS_PHOTO_BUCKET=kisandirect-listings-dev
KYODP_DATA_BUCKET=kisandirect-kyodp-dev
CDN_BASE=https://d1234567890.cloudfront.net

# ============================================================
# NOTIFICATIONS
# ============================================================
WHATSAPP_API_URL=replace-with-360dialog-api-url
WHATSAPP_API_TOKEN=replace-with-360dialog-api-token
WHATSAPP_BUSINESS_PHONE_ID=replace-with-phone-id
WHATSAPP_BUSINESS_ACCOUNT_ID=replace-with-account-id
BHASHINI_API_URL=replace-with-bhashini-api-url
BHASHINI_API_TOKEN=replace-with-bhashini-api-token

# ============================================================
# EXTERNAL SERVICES
# ============================================================
AGMARKNET_API_URL=replace-with-agmarknet-api-url
AGMARKNET_API_KEY=replace-with-agmarknet-api-key

# ============================================================
# APPLICATION CONFIGURATION
# ============================================================
NODE_ENV=development
LOG_LEVEL=info
PORT=4000
BASE_URL=http://localhost:4000
API_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============================================================
# DEVELOPMENT ONLY
# ============================================================
DEBUG=false
MOCK_EXTERNAL_APIS=false
DB_AUTO_MIGRATE=true
